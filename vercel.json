{
  "rewrites": [
    { "source": "/konfigurator", "destination": "/konfigurator.html" },
    { "source": "/polityka", "destination": "/polityka.html" },
    { "source": "/kontakt", "destination": "/kontakt.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/rozwiazania/pieczywo", "destination": "/rozwiazania/pieczywo.html" },
    { "source": "/rozwiazania/jajka", "destination": "/rozwiazania/jajka.html" },
    { "source": "/rozwiazania/sery", "destination": "/rozwiazania/sery.html" },
    { "source": "/rozwiazania/ziemniaki-warzywa", "destination": "/rozwiazania/ziemniaki-warzywa.html" },
    { "source": "/rozwiazania/bio-lokalne", "destination": "/rozwiazania/bio-lokalne.html" },
    { "source": "/rozwiazania/mieso-dania", "destination": "/rozwiazania/mieso-dania.html" },
    { "source": "/rozwiazania/napoje", "destination": "/rozwiazania/napoje.html" },
    { "source": "/jak-dzialamy", "destination": "/jak-dzialamy.html" },
    { "source": "/finansowanie", "destination": "/finansowanie.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
